{
    "name": "Parcel App Template",
    "short_name": "Parcel App",
    "description": "Basic structure for a website/webapp with Parcel.js",
    "theme_color": "#008080",
    "background_color": "#fafafa",
    "display": "standalone",
    "orientation": "portrait",
    "start_url": "/",
